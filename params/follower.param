# ============================================================
# FOLLOWER DRONE — ArduCopter parameter file
# Board: MicoAir743-AIO (STM32H743, confirmed via ArduPilot's own
#        wiki page for this exact board — UART table below is real,
#        not guessed)
#
# UART MAPPING (from ardupilot.org/copter/docs/common-MicoAir743-AIO.html):
#   SERIAL0 -> USB
#   SERIAL1 -> UART1  (MAVLink2 by default)  --> ESP32 companion link
#   SERIAL2 -> UART2  (DisplayPort by default) --> unused, no VTX in this build
#   SERIAL3 -> UART3  (GPS by default)        --> Walksnail WS-M181 GPS (its QMC5883 compass goes on the FC I2C pads)
#   SERIAL4 -> UART4  (MAVLink2 by default)   --> MTF-01 optical flow/rangefinder
#   SERIAL5 -> UART6  (RCIN by default)       --> ELRS RX (CRSF, needs TX6+RX6 both wired)
#   SERIAL6 -> UART7  (RX-only, ESC telemetry)
#   SERIAL7 -> UART8  (free/user)
# Cross-checked against the firmware's own board definition, ArduPilot
# Copter-4.6.3 libraries/AP_HAL_ChibiOS/hwdef/MicoAir743-AIO/hwdef.dat:
#   SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8
# which matches the table above. (That hwdef also already defaults
# SERIAL4 to MAVLink2 / OPTIONS 1024 / 115200 for an MTF-01.)
#
# Load this via Mission Planner: Config > Full Parameter List > Load from file
# ALWAYS review before writing — this is a starting point, not gospel.
# ============================================================

# ---- Frame ----
FRAME_CLASS,1                  # Quad
FRAME_TYPE,1                   # X

# ---- SERIAL1 (UART1) — ESP32 companion computer ----
# Matches FC_BAUD=57600 set in the ESP32 firmware (config.h).
# Protocol 2 = MAVLink2, already the board default, set explicitly for clarity.
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57

# ---- SERIAL4 (UART4) — MTF-01 optical flow + rangefinder ----
# Per ardupilot.org/copter/docs/common-mtf-01.html. The sensor itself
# must first be set to output "mav_apm" with mav_id 200 — see
# docs/MTF01_SETUP.md. Without mav_id != 1, ArduPilot 4.5+ may not
# recognise it.
#
# TARGET VERSION: ArduCopter 4.6.x. Firmware version was not confirmed
# when this file was written — check Mission Planner before loading.
SERIAL4_PROTOCOL,1             # MAVLink1 (what the MTF-01 speaks), not 2
SERIAL4_BAUD,115               # 115200
SERIAL4_OPTIONS,1024           # bit 10: don't forward MAVLink to/from this port (4.6 and earlier)
# ArduCopter 4.7+: bit 10 above moved to MAVx_OPTIONS, where x counts
# MAVLink-protocol serial ports, not SERIALx numbers. With SERIAL0 (USB),
# SERIAL1 (ESP32) and SERIAL4 on MAVLink, SERIAL4 is most likely MAV3.
# Reboot after setting SERIAL4_PROTOCOL, then confirm which MAVx it is.
# MAV3_OPTIONS,2               # 4.7+ only: don't forward MAVLink to/from

# ---- SERIAL5 (UART6) — ELRS RX ----
# Already RCIN by default on this board. CRSF auto-detected. No protocol
# change needed — listed here only as a reminder both TX6 AND RX6 must
# be physically wired for CRSF telemetry to work (RX-only wiring will
# receive control but you lose RSSI/link-quality telemetry back).
SERIAL5_PROTOCOL,23

# ---- Battery monitor ----
# Board defaults. Note the board's wiki page says BATT_VOLT_MULT 21.2 but
# the 4.6.3 hwdef compiles in HAL_BATT_VOLT_SCALE 21.12 (~0.4% apart).
# Either is a nominal value, not a calibration: check the reported
# voltage against a multimeter on your pack and adjust BATT_VOLT_MULT.
BATT_MONITOR,4
BATT_VOLT_PIN,10
BATT_CURR_PIN,11
BATT_VOLT_MULT,21.2
BATT_AMP_PERVLT,14.14

# ---- Battery failsafe ----
# 4S pack, RDQ 850mAh. Tune BATT_LOW_VOLT/BATT_CRT_VOLT to your specific
# cells' real discharge curve after a few flights — these are
# conservative starting points, not final.
BATT_LOW_VOLT,14.4             # ~3.6V/cell — land soon
BATT_CRT_VOLT,13.6             # ~3.4V/cell — land NOW
BATT_FS_LOW_ACT,1              # LAND on low battery (RTL needs a position fix; none indoors without GPS)
BATT_FS_CRT_ACT,1              # LAND immediately on critical battery
BATT_ARM_VOLT,15.2             # refuse to arm below ~3.8V/cell

# ---- GPS + compass (Walksnail WS-M181) ----
# The WS-M181 is a u-blox M10 GPS (UART) with a built-in QMC5883 compass
# (I2C). GPS TX/RX -> FC UART3 (SERIAL3); compass SDA/SCL -> FC I2C pads.
# This board probes external I2C compasses (HAL_PROBE_EXTERNAL_I2C_COMPASSES
# in its hwdef) and auto-fixes orientation on calibration
# (COMPASS_AUTO_ROT default 2), so no orientation params are set here.
# GPS type stays at its AUTO default (GPS_TYPE was renamed GPS1_TYPE in 4.6).
SERIAL3_PROTOCOL,5             # GPS (already the board default; explicit)
#
# Compass = EKF yaw source, as in ArduPilot's optical-flow setup docs.
# This replaces gyro-only yaw (which drifts). MUST before flight:
#   - Mount the GPS/compass away from the ESC, battery leads and motors.
#   - Run Mission Planner compass calibration; the FC refuses to arm
#     until it's done (ARMING_CHECK keeps the compass check on).
#   - Indoors, check the heading in the actual flying room: steel, rebar
#     and wiring distort it. Bad heading = flow position control drifts.
COMPASS_ENABLE,1
COMPASS_USE,1
EK3_SRC1_YAW,1                 # Compass

# ---- Optical flow / rangefinder (MTF-01) ----
# (FLOW_ENABLE removed: no such parameter. FLOW_TYPE != 0 enables flow.)
FLOW_TYPE,5                    # MAVLink (6 is DroneCAN — wrong for a UART sensor)
# FLOW_ORIENT_YAW: ArduPilot's default MTF-01 orientation is rotated 180
# degrees from the INAV/FMT one. If mounted the INAV/FMT way, set
# FLOW_ORIENT_YAW,18000. A wrong value inverts flow feedback and can cause
# a flyaway — check flow against attitude before flying (MTF01_SETUP.md).
# TODO(CG measurement): FLOW_POS_X/Y/Z are the sensor's offset from the
# centre of gravity in metres (X forward, Y right, Z down). 0.0 is a
# placeholder, NOT a measured value. Measure once the airframe is built.
FLOW_POS_X,0.0                 # TODO: measure
FLOW_POS_Y,0.0                 # TODO: measure (BOM: lens at y = -9 mm from frame centre -> about -0.009 once CG is confirmed)
FLOW_POS_Z,0.0                 # TODO: measure
RNGFND1_TYPE,10                # MAVLink rangefinder
RNGFND1_ORIENT,25              # Down
RNGFND1_MIN_CM,1               # 4.6 and earlier: centimetres
RNGFND1_MAX_CM,800             # 8 m
# ArduCopter 4.7+ renamed these to metres:
# RNGFND1_MIN,0.01
# RNGFND1_MAX,8

# ---- EKF3 sources — flow-based nav (no GPS assumed for indoor flight) ----
EK3_ENABLE,1
EK3_SRC1_VELXY,5               # optical flow for XY velocity
EK3_SRC1_VELZ,0                # none (default 3 = GPS; no GPS fix indoors). Per ardupilot.org optical flow setup
EK3_SRC1_POSZ,2                # rangefinder for altitude
EK3_SRC1_POSXY,0               # no XY position source without GPS — GUIDED
                                # velocity control still works fine on flow alone

# ---- Arming checks ----
# ARMING_CHECK is ArduPilot's ONLY arming-check parameter — a single
# bitmask, where the value 1 specifically means "all checks," not bit
# position 0. There is no separate "ARMING_CHECK_MASK" parameter; an
# earlier draft of this file invented one that doesn't exist in real
# ArduPilot and would have silently done nothing on load.
#
# Left at 1 (all checks) deliberately. The compass check stays ON (the
# WS-M181 compass is used for yaw). Indoors there is no GPS fix, so the
# FC will REFUSE TO ARM until you go into Mission Planner's Setup ->
# Mandatory Hardware -> Arming Checks screen and manually UNCHECK just
# "GPS Lock" there. Doing it through that
# GUI is deliberate: it shows you exactly which checks are on/off with
# no bitmask arithmetic to get wrong, which matters here because
# getting a hand-computed bitmask wrong risks silently disabling MORE
# checks than intended, not fewer — the dangerous direction to err in.
ARMING_CHECK,1
# ArduCopter 4.7+: ARMING_CHECK no longer exists. It was replaced by
# ARMING_SKIPCHK, an inverted mask whose default 0 means "skip nothing" —
# the same safe outcome as ARMING_CHECK=1. On 4.7 Mission Planner will
# report ARMING_CHECK as unknown when loading this file; that is expected.
# Do not "fix" it by setting ARMING_SKIPCHK to anything but 0 here.

# ---- Failsafes ----
FS_THR_ENABLE,3                # RC loss failsafe: always LAND (not RTL - no GPS fix indoors, so no home)
FS_THR_VALUE,975               # below this PWM on throttle = failsafe
FS_OPTIONS,0
FS_GCS_ENABLE,0                # no GCS failsafe — companion link loss
                                # should not itself trigger a failsafe,
                                # RC loss is the one that matters here

# ---- GUIDED mode (used by the ESP32 follower velocity commands) ----
GUID_OPTIONS,0

# ---- RC switches: SET THESE BEFORE FLYING (commented out on purpose) ----
# The LiteRadio 3's switch-to-channel mapping isn't documented, so the
# channel numbers below are placeholders. Find them in Mission Planner:
# Setup -> Mandatory Hardware -> Radio Calibration, flip each switch and
# note which channel moves (and whether it has 2 or 3 positions).
# Do NOT use channels 1-4 (sticks). ELRS uses channel 5 as its arm/AUX1
# channel; keep the e-stop on a 2-position switch.
#
# Flight-mode switch (3-position; ArduCopter reads PWM bands, a 3-pos
# switch lands on FLTMODE1 / FLTMODE4 / FLTMODE6):
# FLTMODE_CH,<3-pos channel>
# FLTMODE1,2      # switch low  = ALT_HOLD  (take off / manual)
# FLTMODE2,2
# FLTMODE3,2
# FLTMODE4,5      # switch mid  = LOITER    (hold position: the abort)
# FLTMODE5,5
# FLTMODE6,4      # switch high = GUIDED    (follower active)
#
# Emergency motor stop (2-position). Motors stop instantly; the drone
# falls. Last resort only:
# RC<ch>_OPTION,31   # Motor Emergency Stop
#
# Arming stays on the sticks (throttle down + yaw right, ARMING_RUDDER
# default) or the console button. No gesture can arm or disarm.

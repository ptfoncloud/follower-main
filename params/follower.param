# ============================================================
# FOLLOWER DRONE — ArduCopter parameter file
# Board: MicoAir743-AIO (STM32H743, confirmed via ArduPilot's own
#        wiki page for this exact board — UART table below is real,
#        not guessed)
#
# UART MAPPING (from ardupilot.org/copter/docs/common-MicoAir743-AIO.html):
#   SERIAL0 -> USB
#   SERIAL1 -> UART1  (MAVLink2 by default)  --> ESP32 companion link
#   SERIAL2 -> UART2  (DisplayPort by default) --> unused, no VTX in this build
#   SERIAL3 -> UART3  (GPS by default)        --> for when GPS is added
#   SERIAL4 -> UART4  (MAVLink2 by default)   --> MTF-01 optical flow/rangefinder
#   SERIAL5 -> UART6  (RCIN by default)       --> ELRS RX (CRSF, needs TX6+RX6 both wired)
#   SERIAL6 -> UART7  (RX-only, ESC telemetry)
#   SERIAL7 -> UART8  (free/user)
#
# Load this via Mission Planner: Config > Full Parameter List > Load from file
# ALWAYS review before writing — this is a starting point, not gospel.
# ============================================================

# ---- Frame ----
FRAME_CLASS,1                  # Quad
FRAME_TYPE,1                   # X

# ---- SERIAL1 (UART1) — ESP32 companion computer ----
# Matches FC_BAUD=57600 set in the ESP32 firmware (config.h).
# Protocol 2 = MAVLink2, already the board default, set explicitly for clarity.
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57

# ---- SERIAL4 (UART4) — MTF-01 optical flow + rangefinder ----
# MTF-01 speaks MAVLink (OPTICAL_FLOW + DISTANCE_SENSOR messages).
# Baud below is MicoAir's commonly-published default for this sensor —
# VERIFY against your MTF-01 unit before first flight. If it doesn't
# link, check the MTF-01 manual/MicoAir's own setup doc for the exact
# baud they ship it configured at.
SERIAL4_PROTOCOL,2
SERIAL4_BAUD,115

# ---- SERIAL5 (UART6) — ELRS RX ----
# Already RCIN by default on this board. CRSF auto-detected. No protocol
# change needed — listed here only as a reminder both TX6 AND RX6 must
# be physically wired for CRSF telemetry to work (RX-only wiring will
# receive control but you lose RSSI/link-quality telemetry back).
SERIAL5_PROTOCOL,23

# ---- Battery monitor ----
# Real board-calibrated defaults, confirmed via ArduPilot's own page —
# do NOT need to be measured/tuned, this IS what the hardware expects.
BATT_MONITOR,4
BATT_VOLT_PIN,10
BATT_CURR_PIN,11
BATT_VOLT_MULT,21.2
BATT_AMP_PERVLT,14.14

# ---- Battery failsafe ----
# 4S pack, RDQ 850mAh. Tune BATT_LOW_VOLT/BATT_CRT_VOLT to your specific
# cells' real discharge curve after a few flights — these are
# conservative starting points, not final.
BATT_LOW_VOLT,14.4             # ~3.6V/cell — land soon
BATT_CRT_VOLT,13.6             # ~3.4V/cell — land NOW
BATT_FS_LOW_ACT,2              # RTL on low battery
BATT_FS_CRT_ACT,1              # LAND immediately on critical battery
BATT_ARM_VOLT,15.2             # refuse to arm below ~3.8V/cell

# ---- Compass ----
# NO EXTERNAL COMPASS in this build (confirmed: MicoAir743-AIO has no
# built-in compass, and none is in the BOM). Disabling compass fusion
# entirely rather than leaving it half-configured with no sensor.
# REAL CONSEQUENCE: yaw comes from gyro integration only and WILL drift
# over time — fine for short test hops, not for long autonomous missions.
# If you add an external I2C compass later, set COMPASS_ENABLED back to
# 1 and run the compass calibration wizard in Mission Planner.
COMPASS_ENABLED,0
COMPASS_USE,0
EK3_SRC1_YAW,0                 # gyro-only yaw source, expect drift

# ---- Optical flow / rangefinder (MTF-01) ----
FLOW_ENABLE,1
FLOW_TYPE,6                    # MAVLink
FLOW_POS_X,0.0                 # SET THIS: measure real offset from CG once mounted
FLOW_POS_Y,0.0                 # SET THIS
FLOW_POS_Z,0.0                 # SET THIS
RNGFND1_TYPE,10                # MAVLink rangefinder
RNGFND1_MIN_CM,5
RNGFND1_MAX_CM,800             # MTF-01 real max range per datasheet

# ---- EKF3 sources — flow-based nav (no GPS assumed for indoor flight) ----
EK3_ENABLE,1
EK3_SRC1_VELXY,5               # optical flow for XY velocity
EK3_SRC1_POSZ,2                # rangefinder for altitude
EK3_SRC1_POSXY,0               # no XY position source without GPS — GUIDED
                                # velocity control still works fine on flow alone

# ---- Arming checks ----
# ARMING_CHECK is ArduPilot's ONLY arming-check parameter — a single
# bitmask, where the value 1 specifically means "all checks," not bit
# position 0. There is no separate "ARMING_CHECK_MASK" parameter; an
# earlier draft of this file invented one that doesn't exist in real
# ArduPilot and would have silently done nothing on load.
#
# Left at 1 (all checks, including compass and GPS) deliberately. With
# no compass or GPS fitted, this means the FC will correctly REFUSE TO
# ARM until you either add those sensors, or go into Mission Planner's
# Setup -> Mandatory Hardware -> Arming Checks screen and manually
# UNCHECK just "Compass" and "GPS Lock" there. Doing it through that
# GUI is deliberate: it shows you exactly which checks are on/off with
# no bitmask arithmetic to get wrong, which matters here because
# getting a hand-computed bitmask wrong risks silently disabling MORE
# checks than intended, not fewer — the dangerous direction to err in.
ARMING_CHECK,1

# ---- Failsafes ----
FS_THR_ENABLE,1                # RC loss failsafe ON
FS_THR_VALUE,975               # below this PWM on throttle = failsafe
FS_OPTIONS,0
FS_GCS_ENABLE,0                # no GCS failsafe — companion link loss
                                # should not itself trigger a failsafe,
                                # RC loss is the one that matters here

# ---- GUIDED mode (used by the ESP32 follower velocity commands) ----
GUID_OPTIONS,0

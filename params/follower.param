# ============================================================
# follower - ArduCopter 4.7.2 params
# Board: MicoAir743-AIO (STM32H743)
#
# UART map (ardupilot.org/copter/docs/common-MicoAir743-AIO.html):
#   SERIAL0 -> USB
#   SERIAL1 -> UART1  (MAVLink2 default)    --> ESP32 companion
#   SERIAL2 -> UART2  (DisplayPort default) --> unused, no VTX
#   SERIAL3 -> UART3  (GPS default)         --> WS-M181 GPS (its QMC5883 compass goes on the FC I2C pads)
#   SERIAL4 -> UART4  (MAVLink2 default)    --> MTF-01 flow + rangefinder
#   SERIAL5 -> UART6  (RCIN default)        --> ELRS RX (CRSF, wire both TX6 and RX6)
#   SERIAL6 -> UART7  (RX only, ESC telemetry)
#   SERIAL7 -> UART8  (free)
# Matches the board's hwdef.dat in the firmware (4.6.3 and 4.7.2):
#   SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8
#
# Load with Mission Planner: Config > Full Parameter List > Load from file.
# Read it before writing it, it's a starting point.
# ============================================================

# ---- Frame ----
FRAME_CLASS,1                  # Quad
FRAME_TYPE,1                   # X

# ---- SERIAL1 (UART1), ESP32 ----
# has to match FC_BAUD 57600 in config.h. MAVLink2 is already the default,
# just set so it's obvious
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57

# ---- SERIAL4 (UART4), MTF-01 ----
# From ardupilot.org/copter/docs/common-mtf-01.html. The sensor has to be
# set to "mav_apm" with mav_id 200 first (docs/MTF01_SETUP.md), 4.5+ may
# not see it on mav_id 1.
SERIAL4_PROTOCOL,1             # MAVLink1, that's what the MTF-01 speaks
SERIAL4_BAUD,115               # 115200
# Don't forward MAVLink to/from the MTF-01. On 4.7 that's MAVx_OPTIONS
# where x = the Nth MAVLink serial port counting from SERIAL0
# (AP_SerialManager::find_protocol_instance). SERIAL0 USB = MAV1, SERIAL1
# ESP32 = MAV2, SERIAL4 MTF-01 = MAV3. Only holds while SERIAL2/3 aren't
# MAVLink, renumber if that changes. Shows up after a reboot with
# SERIAL4_PROTOCOL set.
MAV3_OPTIONS,2                 # bit 1: don't forward mavlink to/from
# SERIAL4_OPTIONS,1024         # 4.6 and older use this instead

# ---- SERIAL5 (UART6), ELRS RX ----
# Already RCIN by default and CRSF gets auto detected. Only here as a
# reminder to wire both TX6 and RX6, RX only still flies but you lose
# RSSI/link quality telemetry.
SERIAL5_PROTOCOL,23

# ---- Battery monitor ----
# Board defaults. The wiki says BATT_VOLT_MULT 21.2 but the hwdef has
# HAL_BATT_VOLT_SCALE 21.12. Neither is a calibration, check against a
# multimeter and adjust BATT_VOLT_MULT.
BATT_MONITOR,4
BATT_VOLT_PIN,10
BATT_CURR_PIN,11
BATT_VOLT_MULT,21.2
BATT_AMP_PERVLT,14.14

# ---- Battery failsafe ----
# 4S RDQ 850mAh. Conservative starting values, tune to the real discharge
# curve after a few flights.
BATT_LOW_VOLT,14.4             # ~3.6V/cell, land soon
BATT_CRT_VOLT,13.6             # ~3.4V/cell, land now
BATT_FS_LOW_ACT,1              # LAND on low battery (RTL needs a position fix, none indoors)
BATT_FS_CRT_ACT,1              # LAND on critical battery
BATT_ARM_VOLT,15.2             # won't arm below ~3.8V/cell

# ---- GPS + compass (Walksnail WS-M181) ----
# u-blox M10 GPS on UART3 (SERIAL3) + QMC5883 compass on the FC I2C pads.
# The board probes external I2C compasses (AP_COMPASS_PROBING_ENABLED in
# the hwdef) and fixes orientation during calibration
# (COMPASS_AUTO_ROT default 2) so no orientation params here. GPS type is
# left on AUTO (GPS_TYPE got renamed GPS1_TYPE in 4.6).
SERIAL3_PROTOCOL,5             # GPS (already the default)
#
# Compass is the EKF yaw source, same as ArduPilot's optical flow setup.
# Replaces gyro only yaw which drifts. Before flying:
#   - mount the GPS/compass away from the ESC, battery leads and motors
#   - do the compass calibration, it won't arm until you do
#   - check the heading in the actual room. steel, rebar and wiring bend
#     it and a bad heading makes flow position hold drift
COMPASS_ENABLE,1
COMPASS_USE,1
EK3_SRC1_YAW,1                 # Compass

# ---- Optical flow / rangefinder (MTF-01) ----
# (there's no FLOW_ENABLE param, FLOW_TYPE != 0 turns flow on)
FLOW_TYPE,5                    # MAVLink (6 is DroneCAN, wrong for a uart sensor)
# FLOW_ORIENT_YAW: ArduPilot's default MTF-01 orientation is 180 deg off
# from the INAV/FMT one. If it's mounted the INAV/FMT way set
# FLOW_ORIENT_YAW,18000. Wrong value flips the flow feedback and can cause
# a flyaway, check flow vs attitude before flying (MTF01_SETUP.md).
# TODO(CG measurement): FLOW_POS_X/Y/Z = sensor offset from CG in metres
# (X forward, Y right, Z down). 0.0 is a placeholder not a measurement.
FLOW_POS_X,0.0                 # TODO: measure
FLOW_POS_Y,0.0                 # TODO: measure (BOM has the lens at y = -9 mm from frame center, so ~-0.009 once CG is confirmed)
FLOW_POS_Z,0.0                 # TODO: measure
RNGFND1_TYPE,10                # MAVLink rangefinder
RNGFND1_ORIENT,25              # Down
RNGFND1_MIN,0.01               # metres
RNGFND1_MAX,8                  # 8 m
# 4.6 and older used centimetres:
# RNGFND1_MIN_CM,1
# RNGFND1_MAX_CM,800

# ---- EKF3 sources, flow based nav (no GPS indoors) ----
EK3_ENABLE,1
EK3_SRC1_VELXY,5               # optical flow for XY velocity
EK3_SRC1_VELZ,0                # none (default 3 = GPS, no fix indoors). per ardupilot.org flow setup
EK3_SRC1_POSZ,2                # rangefinder for altitude
EK3_SRC1_POSXY,0               # no XY position source without GPS, GUIDED
                                # velocity still works on flow alone

# ---- Arming checks ----
# All checks on. Compass check stays on since the WS-M181 compass is used
# for yaw. Indoors there's no GPS fix so it won't arm until you untick
# just "GPS Lock" in Setup > Mandatory Hardware > Arming Checks. Do it in
# the GUI, not by hand, a wrong hand computed bitmask can turn off more
# checks than you meant to.
# 4.7 removed ARMING_CHECK. ARMING_SKIPCHK replaced it and it's inverted,
# 0 = skip nothing = the old ARMING_CHECK,1. The GUI sets the GPS Lock bit.
ARMING_SKIPCHK,0
# ARMING_CHECK,1               # 4.6 and older use this instead

# ---- Failsafes ----
FS_THR_ENABLE,3                # RC loss: always LAND (not RTL, no GPS fix indoors so no home)
FS_THR_VALUE,975               # throttle PWM below this = failsafe
FS_OPTIONS,0
FS_GCS_ENABLE,0                # no GCS failsafe. losing the companion link
                                # shouldn't trigger one, RC loss is the
                                # one that matters

# ---- GUIDED (what the ESP32's velocity commands use) ----
GUID_OPTIONS,0

# ---- RC switches: set these before flying (commented out on purpose) ----
# Couldn't find the LiteRadio 3's switch to channel mapping documented
# anywhere so the channels below are placeholders. Find them in Mission
# Planner: Setup > Mandatory Hardware > Radio Calibration, flip each switch
# and write down which channel moves and if it's 2 or 3 position.
# Don't use channels 1-4 (sticks). ELRS uses channel 5 as AUX1/arm. Put
# the e-stop on a 2 position switch.
#
# Flight mode switch (3 position). ArduCopter reads PWM bands, a 3 pos
# switch lands on FLTMODE1 / FLTMODE4 / FLTMODE6:
# FLTMODE_CH,<3-pos channel>
# FLTMODE1,2      # low  = ALT_HOLD (takeoff / manual)
# FLTMODE2,2
# FLTMODE3,2
# FLTMODE4,5      # mid  = LOITER   (hold position, the abort)
# FLTMODE5,5
# FLTMODE6,4      # high = GUIDED   (follower on)
#
# Emergency motor stop (2 position). Motors stop instantly and it falls.
# Last resort:
# RC<ch>_OPTION,31   # Motor Emergency Stop
#
# Arming stays on the sticks (throttle down + yaw right, ARMING_RUDDER
# default) or the console button. No gesture can arm or disarm.
